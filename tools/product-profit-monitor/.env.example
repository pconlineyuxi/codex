# Copy to .env; never commit credentials or runtime evidence.
PROFIT_STATE_DB=.runtime/monitor.sqlite3
# No DATABASE_URL means real queries fail, never implicit demo fallback.
DATABASE_URL=
# Complete real-data contract and read-only DB configuration before enabling.
PROFIT_LIVE_CONTRACT_CONFIRMED=no
PROFIT_READY_FILE=.runtime/ready.json
PROFIT_READY_MAX_AGE_SECONDS=129600
MAX_RESULT_ROWS=50000
# Optional parser. Without key the deterministic local parser remains available.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# Off by default. Only Yuxi; must also disable shadow on a live plan.
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVER_OPEN_ID=
FEISHU_RECEIVER_CONFIRMED=
# Authenticated HTTPS tool URL after server deployment. No credentials in URL.
MONITOR_PUBLIC_URL=
